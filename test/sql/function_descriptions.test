# name: test/sql/function_descriptions.test
# description: test netquack function catalog metadata
# group: [sql]

require netquack

# Every registered netquack function has a description, example, and category.
# When adding a function, include its name in the IN (...) list below (see AGENTS.md → Catalog Metadata).
query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name IN (
	'extract_domain', 'extract_path', 'extract_schema', 'extract_host', 'extract_query_string',
	'extract_query_parameters', 'extract_tld', 'extract_subdomain', 'extract_port', 'extract_extension',
	'update_tranco', 'get_tranco_rank', 'get_tranco_rank_category', 'ipcalc', 'is_valid_ip', 'is_private_ip',
	'ip_to_int', 'int_to_ip', 'ip_version', 'ip_in_range', 'ip_to_ptr', 'ipv6_compress', 'ipv6_expand', 'is_ipv4_mapped', 'ip_type', 'is_bogon', 'ip_anonymize', 'extract_fragment', 'domain_depth', 'normalize_url',
	'base64_encode', 'base64_decode', 'is_valid_url', 'is_valid_domain', 'is_public_suffix', 'is_known_tld', 'extract_path_segments',
	'url_encode', 'url_decode', 'parse_uri', 'netquack_version'
)
  AND (description IS NULL OR len(examples) = 0 OR len(categories) = 0);
----
0

# Scalar URL function
query IIII
SELECT function_name, parameters, categories[1], description
FROM duckdb_functions()
WHERE function_name = 'extract_domain';
----
extract_domain	[url]	url	Extracts the registrable domain from a URL using the Public Suffix List.

# STRUCT-returning URL function
query IIII
SELECT function_name, parameters, categories[1], description
FROM duckdb_functions()
WHERE function_name = 'parse_uri';
----
parse_uri	[url]	url	Parses a URI and returns a STRUCT with scheme, host, port, path, query, and fragment.

# Table function
query III
SELECT function_name, parameters, categories[1]
FROM duckdb_functions()
WHERE function_name = 'ipcalc';
----
ipcalc	[cidr]	ip

# Integer parameter name
query II
SELECT function_name, parameters
FROM duckdb_functions()
WHERE function_name = 'int_to_ip';
----
int_to_ip	[ip_int]

# Overloaded scalar function keeps metadata for each signature
query II
SELECT parameters, examples[1]
FROM duckdb_functions()
WHERE function_name = 'ip_anonymize'
ORDER BY len(parameters);
----
[ip]	SELECT ip_anonymize('192.168.1.123');
[ip, ipv4_prefix, ipv6_prefix]	SELECT ip_anonymize('2001:db8:abcd:1234::1', 16, 32);

# Zero-argument table function
query III
SELECT function_name, parameters, categories[1]
FROM duckdb_functions()
WHERE function_name = 'netquack_version';
----
netquack_version	[]	utility
